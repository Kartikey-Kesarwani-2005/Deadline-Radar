{
  "name": "Deadline Radar",
  "short_name": "Deadline Radar",
  "description": "Paste or speak any college assignment message and know what is due today, this week and what is getting late. Built hands-free with Wispr Flow.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "title": "title", "text": "text" }
  },
  "background_color": "#f3eee1",
  "theme_color": "#f3eee1",
  "icons": [
    {
      "src": "./favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
